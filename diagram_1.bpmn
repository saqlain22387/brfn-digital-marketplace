<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:process id="product-listing-process" name="Product Listing and Verification" isExecutable="true">
    <bpmn:extensionElements />
    <bpmn:startEvent id="StartEvent_1" name="Producer initiates listing">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Submit" name="Submit Product Details">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Producer_Submission_Form" />
        <zeebe:assignmentDefinition assignee="demo" candidateGroups="demo" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Organic" name="Is product organic?">
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_1byjyr0</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ManualReview" name="Manual Review by Admin">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Admin_Review_Form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1fitvdb</bpmn:incoming>
      <bpmn:outgoing>Flow_Error_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Error" name="Listing Held for Review">
      <bpmn:incoming>Flow_Error_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Publish" name="Product Published">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_1c377vo</bpmn:incoming>
      <bpmn:incoming>Flow_1byjyr0</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_Yes" name="Yes" sourceRef="Gateway_Organic" targetRef="Task_Verify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= isOrganic = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Verify" targetRef="End_Publish" />
    <bpmn:sequenceFlow id="Flow_Error_End" sourceRef="Task_ManualReview" targetRef="End_Error" />
    <bpmn:parallelGateway id="Gateway_0vznbjr">
      <bpmn:outgoing>Flow_1odcnxq</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_1odcnxq" sourceRef="Gateway_0vznbjr" targetRef="Activity_0jyzl9u" />
    <bpmn:serviceTask id="Activity_0jyzl9u" name="Send Confirmation Email">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-email" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1odcnxq</bpmn:incoming>
      <bpmn:outgoing>Flow_1c377vo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1c377vo" sourceRef="Activity_0jyzl9u" targetRef="End_Publish" />
    <bpmn:serviceTask id="Task_Verify" name="Verify Certification (External)">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=productName" target="requestedProduct" />
          <zeebe:output source="=true" target="isVerified" />
        </zeebe:ioMapping>
        <zeebe:taskDefinition type="verify-certification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Error_ServiceDown" name="Service Unavailable" attachedToRef="Task_Verify">
      <bpmn:outgoing>Flow_1fitvdb</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0do1hrr">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=duration("PT10S")</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1fitvdb" sourceRef="Error_ServiceDown" targetRef="Task_ManualReview" />
    <bpmn:sequenceFlow id="Flow_1byjyr0" name="NO" sourceRef="Gateway_Organic" targetRef="End_Publish">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isOrganic = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="product-listing-process">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="179" y="159" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Submit_di" bpmnElement="Task_Submit">
        <dc:Bounds x="270" y="137" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Organic_di" bpmnElement="Gateway_Organic" isMarkerVisible="true">
        <dc:Bounds x="425" y="152" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="425" y="102" width="49" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManualReview_di" bpmnElement="Task_ManualReview">
        <dc:Bounds x="560" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Error_di" bpmnElement="End_Error">
        <dc:Bounds x="692" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="673" y="348" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Publish_di" bpmnElement="End_Publish">
        <dc:Bounds x="820" y="159" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="793" y="135" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_0vznbjr_di" bpmnElement="Gateway_0vznbjr">
        <dc:Bounds x="365" y="152" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1fpx9ig_di" bpmnElement="Activity_0jyzl9u">
        <dc:Bounds x="340" y="420" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0b0gm2j_di" bpmnElement="Task_Verify">
        <dc:Bounds x="550" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_019d9rl_di" bpmnElement="Error_ServiceDown">
        <dc:Bounds x="582" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="521" y="218" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="215" y="177" />
        <di:waypoint x="270" y="177" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes_di" bpmnElement="Flow_Yes">
        <di:waypoint x="475" y="177" />
        <di:waypoint x="550" y="177" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="504" y="152" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="650" y="160" />
        <di:waypoint x="735" y="160" />
        <di:waypoint x="735" y="177" />
        <di:waypoint x="820" y="177" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Error_End_di" bpmnElement="Flow_Error_End">
        <di:waypoint x="610" y="290" />
        <di:waypoint x="610" y="270" />
        <di:waypoint x="710" y="270" />
        <di:waypoint x="710" y="312" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1odcnxq_di" bpmnElement="Flow_1odcnxq">
        <di:waypoint x="390" y="202" />
        <di:waypoint x="390" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1c377vo_di" bpmnElement="Flow_1c377vo">
        <di:waypoint x="440" y="460" />
        <di:waypoint x="960" y="460" />
        <di:waypoint x="960" y="177" />
        <di:waypoint x="856" y="177" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1fitvdb_di" bpmnElement="Flow_1fitvdb">
        <di:waypoint x="600" y="218" />
        <di:waypoint x="600" y="254" />
        <di:waypoint x="580" y="254" />
        <di:waypoint x="580" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1byjyr0_di" bpmnElement="Flow_1byjyr0">
        <di:waypoint x="475" y="177" />
        <di:waypoint x="820" y="177" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="681" y="170" width="17" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
